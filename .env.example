LLM_PROVIDER=azure # one of: openai|azure
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# Azure (if LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# External Fresh Agent API
FRESH_AGENT_API_BASE_URL=https://your-fresh-agent.example.com
FRESH_AGENT_API_KEY=your-fresh-agent-api-key
FRESH_AGENT_API_TIMEOUT_SECONDS=30

# Store Insights API
STORE_INSIGHTS_API_URL=http://localhost:8000/v1/api

# Not used yet - for future Cosmos DB integration for storing chat history, user data, etc.
COSMOS_DB_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_DB_KEY=
COSMOS_DB_DATABASE=store-insights
COSMOS_DB_CONTAINER=documents

# Application insights
APPLICATION_INSIGHTS_CONNECTION_STRING=your-appinsights-connection-string